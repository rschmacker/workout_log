# Copy this file to ".env.local" and fill in the values from
# Supabase: Project Settings -> API Keys (and Data API for the URL).
# .env.local is ignored by git, so the keys never end up on GitHub.

# Only the base address, without "/rest/v1/" at the end
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon public" key, or the newer "publishable" key (sb_publishable_...).
# Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
